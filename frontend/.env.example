# ----------------------------------------------------------------------------
# VeriGuard AI — frontend environment
# Copy to `.env.local` and adjust for your machine.
# ----------------------------------------------------------------------------

# FastAPI backend origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Demo mode.
#   true  -> the app is fully self-contained: auth, screening pipeline, cases,
#            analytics and audit logs are served from deterministic in-browser
#            fixtures. Use this for the SIH live demonstration.
#   false -> every call goes to NEXT_PUBLIC_API_BASE_URL. Endpoints that the
#            backend has not implemented yet will surface as partial/failed
#            states in the UI (which is the intended, honest behaviour).
NEXT_PUBLIC_DEMO_MODE=true

# Request timeout for backend calls, in milliseconds.
NEXT_PUBLIC_API_TIMEOUT=30000

# Supabase Cloud Configuration (Optional direct frontend access)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
