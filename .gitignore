# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
ENV/
env/

# Environment Variables
.env
.env.*
*.env*
!*.env.example

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo

# Large Model Checkpoints and Serialized Weights (>100MB)
# Note: Keep lightweight configs and metadata tracked if needed
models/*.bin
models/*.pt
models/*.pth
models/*.onnx
models/*.h5
models/*.safetensors
models/**/*.zip
!models/.gitkeep

# Data (Raw / Large Datasets / Dynamic Runtime Captures)
data/raw/
data/processed/
data/captures/*
!data/captures/.gitkeep
data/*.csv
data/*.parquet
data/*.jsonl
data/*.zip
data/*.tar.gz
!data/.gitkeep

# Loose test scripts & test image artifacts
test_*.jpg
test_*.png
test_*.jpeg
backend/test_*.py
backend/test_*.jpg
walkthrough.md

# Logs and outputs
logs/
*.log

# Local Database Files
*.db
*.sqlite
*.sqlite3
*.zip
*.tar.gz


